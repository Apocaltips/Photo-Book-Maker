{
  "name": "photo-book-maker",
  "private": true,
  "main": "apps/mobile/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @photo-book-maker/web",
    "dev:mobile": "npm run start -w @photo-book-maker/mobile",
    "build": "npm run build -w @photo-book-maker/web",
    "lint": "npm run lint -w @photo-book-maker/web",
    "typecheck": "npm run typecheck -w @photo-book-maker/core && npm run typecheck -w @photo-book-maker/web && npm run typecheck -w @photo-book-maker/mobile",
    "test": "npm run test -w @photo-book-maker/core",
    "test:ai:health": "npm run test:ai:health -w @photo-book-maker/web",
    "test:ai:benchmark": "npm run test:ai:benchmark -w @photo-book-maker/web",
    "test:ai:local": "npm run test:ai:local -w @photo-book-maker/web",
    "test:e2e:web": "npm run test:e2e -w @photo-book-maker/web",
    "worker:ai:local": "npm run worker:ai:local -w @photo-book-maker/web"
  }
}
